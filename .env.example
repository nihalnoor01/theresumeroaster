# The Resume Roaster - Local Environment Variables

# Option 1: Use your standard Google Gemini API Key
# Gemini API OpenAI compatibility endpoint will be used with model: gemini-2.5-flash
GEMINI_API_KEY=your-gemini-api-key-here

# Option 2: Use your OpenAI API Key
# Standard OpenAI endpoint will be used with model: gpt-4o-mini
OPENAI_API_KEY=your-openai-api-key-here
